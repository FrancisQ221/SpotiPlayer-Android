{
  "name": "spoplayer-android",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpoPlayer Android — official mobile client powered by Capacitor",
  "author": {
    "name": "FrancisQ221",
    "email": "pablocuches@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:copy": "cap copy android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:debug": "pnpm build && pnpm cap:copy && cd android && .\\gradlew.bat assembleDebug",
    "android:release": "pnpm build && pnpm cap:copy && cd android && .\\gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@braccato/core": "^1.4.0",
