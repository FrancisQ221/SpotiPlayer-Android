    "@solar-icons/react": "^1.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@xhayper/discord-rpc": "^1.5.1",
    "bgutils-js": "4.0.3",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "morphicons": "^1.7.1",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-apple-emojis": "^3.0.0",
